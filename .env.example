# threadpilot · environment variables
# Скопируйте этот файл в .env и заполните значения

# ── Firecrawl ─────────────────────────────────────────────
# API-ключ для Firecrawl (https://firecrawl.dev)
# Бесплатный тир: 500 страниц/месяц
# Также можно задать через дашборд (http://localhost:3000)
FIRECRAWL_KEY=fc-xxxxxxxxxxxxxxxxxxxx

# ── Порт сервера ──────────────────────────────────────────
# По умолчанию 3000, менять не обязательно
# PORT=3000
